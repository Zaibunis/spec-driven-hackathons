# Docker Compose - Environment Variables Template
# Copy to .env (same directory) and fill with real values. NEVER commit .env.

# Local Postgres container credentials
POSTGRES_DB=todo_db
POSTGRES_USER=user
POSTGRES_PASSWORD=""

# Backend connection string (points at the local db service)
DATABASE_URL=postgresql://user:CHANGE_ME@db:5432/todo_db

# Auth secrets - generate with: openssl rand -base64 32
JWT_SECRET=""
