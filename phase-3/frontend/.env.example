# Todo Frontend - Environment Variables Template
# Copy to .env.local and fill with real values. NEVER commit .env.local.
#
# SECURITY: Any var with the NEXT_PUBLIC_ prefix is embedded in the browser
# JS bundle and is fully PUBLIC. Never put API keys or secrets here.
# All secrets (GEMINI_API_KEY, JWT_SECRET, BETTER_AUTH_SECRET, DATABASE_URL)
# belong in backend/.env and in the backend service's environment (Vercel).

# Backend API base URL (the only frontend var that should exist)
NEXT_PUBLIC_API_URL=http://localhost:8000
