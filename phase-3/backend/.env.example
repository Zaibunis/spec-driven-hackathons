# Todo Backend - Environment Variables Template
# Copy to .env and fill with real values. NEVER commit .env.
#
# SECURITY: The previous Neon password was leaked in git history.
# Rotate the password in the Neon Console before deploying.

# PostgreSQL connection string (Neon Serverless or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth secrets - generate with: openssl rand -base64 32
JWT_SECRET=""
BETTER_AUTH_SECRET=""

# Google Gemini API key - https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Server config
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
DEBUG=false
